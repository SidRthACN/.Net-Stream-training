<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LHM - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="topbar">
        <div class="brand">LHM</div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav>
                <a asp-controller="Patient" asp-action="Index">All Patients</a>
                <a asp-controller="Patient" asp-action="Create">Add New Patient</a>
                <a asp-controller="Appointment" asp-action="Create">Add New Appointment</a>
                <a asp-controller="Appointment" asp-action="Index">All Appointments</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    <button type="submit">Logout</button>
                </form>
            </nav>
        }
    </header>
    <main class="container">
        @if (TempData["Error"] != null)
        {
            <div class="alert">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
    <footer>Multi Online Assessment © 2021-2031</footer>
</body>
</html>
